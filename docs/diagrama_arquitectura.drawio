                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef usuario fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A;\n    classDef coordinacion fill:#EDE9FE,stroke:#7C3AED,color:#4C1D95;\n    classDef funcion fill:#DCFCE7,stroke:#16A34A,color:#14532D;\n    classDef credencial fill:#FEF3C7,stroke:#D97706,color:#78350F;\n    classDef salida fill:#F1F5F9,stroke:#64748B,color:#0F172A;\n    classDef error fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D;\n    classDef decision fill:#FFFFFF,stroke:#64748B,color:#0F172A;\n\n    subgraph LEYENDA[\&quot;Leyenda\&quot;]\n        direction TB\n        L1[\&quot;Entrada o acción del usuario\&quot;]:::usuario\n        L2[\&quot;Coordinación del programa\&quot;]:::coordinacion\n        L3[\&quot;Función definida en el código\&quot;]:::funcion\n        L4[\&quot;Credencial o configuración\&quot;]:::credencial\n        L5[\&quot;Salida en consola\&quot;]:::salida\n        L6[\&quot;Error o excepción\&quot;]:::error\n    end\n\n    INICIO([\&quot;Iniciar\&quot;]):::usuario\n    MAIN[\&quot;Ejecutar el programa&lt;br/&gt;__main__\&quot;]:::coordinacion\n    CARGAR[\&quot;Cargar la configuración&lt;br/&gt;load_dotenv() y GEMINI_API_KEY\&quot;]:::credencial\n    ENTRADA[\&quot;Definir la pregunta&lt;br/&gt;Texto escrito en el programa\&quot;]:::usuario\n    OBTENER[\&quot;Coordinar la consulta&lt;br/&gt;obtener_dato_de_prueba(pregunta)\&quot;]:::funcion\n    ARMAR[\&quot;Preparar la petición&lt;br/&gt;armar_peticion(...)\&quot;]:::funcion\n    VALIDAR{\&quot;Validar la pregunta\&quot;}:::decision\n    ENVIAR[\&quot;Enviar y validar la respuesta HTTP&lt;br/&gt;enviar_peticion(url, body)\&quot;]:::funcion\n    COSTO[\&quot;Calcular el costo&lt;br/&gt;calcular_costo(datos, precios)\&quot;]:::funcion\n    EXTRAER[\&quot;Extraer el texto de Gemini&lt;br/&gt;extraer_texto(datos)\&quot;]:::funcion\n    PARSEAR[\&quot;Procesar y validar el JSON&lt;br/&gt;parsear_respuesta_json(texto, claves)\&quot;]:::funcion\n    RESULTADO[\&quot;Mostrar el resultado&lt;br/&gt;Respuesta, latencia y costo\&quot;]:::salida\n    FIN([\&quot;Finalizar\&quot;]):::usuario\n\n    ERROR_VALIDACION[\&quot;Generar ValueError&lt;br/&gt;Pregunta vacía o JSON inválido\&quot;]:::error\n    ERROR_SERVICIO[\&quot;Generar RuntimeError&lt;br/&gt;Conexión, timeout, HTTP o respuesta inválida\&quot;]:::error\n    CAPTURAR[\&quot;Capturar errores previstos&lt;br/&gt;except ValueError o RuntimeError\&quot;]:::error\n    MOSTRAR_ERROR[\&quot;Mostrar el mensaje de error\&quot;]:::salida\n    ERROR_COSTO[\&quot;Considerar KeyError no capturado&lt;br/&gt;Si falta usageMetadata\&quot;]:::error\n\n    INICIO --&gt;|\&quot;Inicio\&quot;| MAIN\n    MAIN --&gt;|\&quot;Ejecución\&quot;| CARGAR\n    CARGAR --&gt;|\&quot;GEMINI_API_KEY\&quot;| OBTENER\n    ENTRADA --&gt;|\&quot;pregunta (str)\&quot;| OBTENER\n    OBTENER --&gt;|\&quot;pregunta y configuración\&quot;| ARMAR\n    ARMAR --&gt;|\&quot;URL y body\&quot;| VALIDAR\n    VALIDAR --&gt;|\&quot;Pregunta válida\&quot;| ENVIAR\n    ENVIAR --&gt;|\&quot;datos (dict)\&quot;| COSTO\n    COSTO --&gt;|\&quot;datos procesados\&quot;| EXTRAER\n    EXTRAER --&gt;|\&quot;texto generado\&quot;| PARSEAR\n    PARSEAR --&gt;|\&quot;categoria y nivel\&quot;| RESULTADO\n    RESULTADO --&gt;|\&quot;Ejecución exitosa\&quot;| FIN\n\n    VALIDAR --&gt;|\&quot;Pregunta vacía: ValueError\&quot;| ERROR_VALIDACION\n    ENVIAR -.-&gt;|\&quot;ConnectionError, Timeout, HTTP != 200 o JSONDecodeError\&quot;| ERROR_SERVICIO\n    EXTRAER -.-&gt;|\&quot;KeyError o IndexError\&quot;| ERROR_SERVICIO\n    PARSEAR -.-&gt;|\&quot;ValueError\&quot;| ERROR_VALIDACION\n\n    ERROR_VALIDACION --&gt;|\&quot;ValueError\&quot;| CAPTURAR\n    ERROR_SERVICIO --&gt;|\&quot;RuntimeError\&quot;| CAPTURAR\n    CAPTURAR --&gt;|\&quot;Mensaje de excepción\&quot;| MOSTRAR_ERROR\n    MOSTRAR_ERROR --&gt;|\&quot;Proceso detenido\&quot;| FIN\n\n    COSTO -.-&gt;|\&quot;KeyError posible\&quot;| ERROR_COSTO&quot;,&#xa;  &quot;config&quot;: {&#xa;    &quot;startOnLoad&quot;: false,&#xa;    &quot;themeCSS&quot;: &quot;&quot;,&#xa;    &quot;theme&quot;: &quot;default&quot;,&#xa;    &quot;arrowMarkerAbsolute&quot;: false,&#xa;    &quot;flowchart&quot;: {&#xa;      &quot;diagramPadding&quot;: 8,&#xa;      &quot;htmlLabels&quot;: true,&#xa;      &quot;nodeSpacing&quot;: 50,&#xa;      &quot;rankSpacing&quot;: 50,&#xa;      &quot;curve&quot;: &quot;linear&quot;,&#xa;      &quot;padding&quot;: 15,&#xa;      &quot;useMaxWidth&quot;: true&#xa;    },&#xa;    &quot;sequence&quot;: {&#xa;      &quot;activationWidth&quot;: 10,&#xa;      &quot;diagramMarginX&quot;: 50,&#xa;      &quot;diagramMarginY&quot;: 10,&#xa;      &quot;actorMargin&quot;: 50,&#xa;      &quot;width&quot;: 150,&#xa;      &quot;height&quot;: 65,&#xa;      &quot;boxMargin&quot;: 10,&#xa;      &quot;boxTextMargin&quot;: 5,&#xa;      &quot;noteMargin&quot;: 10,&#xa;      &quot;messageMargin&quot;: 35,&#xa;      &quot;messageAlign&quot;: &quot;center&quot;,&#xa;      &quot;mirrorActors&quot;: true,&#xa;      &quot;bottomMarginAdj&quot;: 1,&#xa;      &quot;useMaxWidth&quot;: true,&#xa;      &quot;rightAngles&quot;: false,&#xa;      &quot;showSequenceNumbers&quot;: false,&#xa;      &quot;actorFontSize&quot;: 14,&#xa;      &quot;actorFontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#xa;      &quot;actorFontWeight&quot;: 400,&#xa;      &quot;noteFontSize&quot;: 14,&#xa;      &quot;noteFontFamily&quot;: &quot;\&quot;trebuchet ms\&quot;, verdana, arial&quot;,&#xa;      &quot;noteFontWeight&quot;: 400,&#xa;      &quot;noteAlign&quot;: &quot;center&quot;,&#xa;      &quot;messageFontSize&quot;: 16,&#xa;      &quot;messageFontFamily&quot;: &quot;\&quot;trebuchet ms\&quot;, verdana, arial&quot;,&#xa;      &quot;messageFontWeight&quot;: 400,&#xa;      &quot;wrap&quot;: false,&#xa;      &quot;wrapPadding&quot;: 10,&#xa;      &quot;labelBoxWidth&quot;: 50,&#xa;      &quot;labelBoxHeight&quot;: 20&#xa;    },&#xa;    &quot;gantt&quot;: {&#xa;      &quot;titleTopMargin&quot;: 25,&#xa;      &quot;barHeight&quot;: 20,&#xa;      &quot;barGap&quot;: 4,&#xa;      &quot;topPadding&quot;: 50,&#xa;      &quot;leftPadding&quot;: 75,&#xa;      &quot;gridLineStartPadding&quot;: 35,&#xa;      &quot;fontSize&quot;: 11,&#xa;      &quot;fontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#xa;      &quot;numberSectionStyles&quot;: 4,&#xa;      &quot;axisFormat&quot;: &quot;%Y-%m-%d&quot;,&#xa;      &quot;useMaxWidth&quot;: true&#xa;    },&#xa;    &quot;journey&quot;: {&#xa;      &quot;diagramMarginX&quot;: 50,&#xa;      &quot;diagramMarginY&quot;: 10,&#xa;      &quot;actorMargin&quot;: 50,&#xa;      &quot;width&quot;: 150,&#xa;      &quot;height&quot;: 65,&#xa;      &quot;boxMargin&quot;: 10,&#xa;      &quot;boxTextMargin&quot;: 5,&#xa;      &quot;noteMargin&quot;: 10,&#xa;      &quot;messageMargin&quot;: 35,&#xa;      &quot;messageAlign&quot;: &quot;center&quot;,&#xa;      &quot;bottomMarginAdj&quot;: 1,&#xa;      &quot;useMaxWidth&quot;: true,&#xa;      &quot;rightAngles&quot;: false&#xa;    },&#xa;    &quot;class&quot;: {&#xa;      &quot;arrowMarkerAbsolute&quot;: false,&#xa;      &quot;useMaxWidth&quot;: true&#xa;    },&#xa;    &quot;git&quot;: {&#xa;      &quot;arrowMarkerAbsolute&quot;: false,&#xa;      &quot;useMaxWidth&quot;: true&#xa;    },&#xa;    &quot;state&quot;: {&#xa;      &quot;dividerMargin&quot;: 10,&#xa;      &quot;sizeUnit&quot;: 5,&#xa;      &quot;padding&quot;: 8,&#xa;      &quot;textHeight&quot;: 10,&#xa;      &quot;titleShift&quot;: -15,&#xa;      &quot;noteMargin&quot;: 10,&#xa;      &quot;forkWidth&quot;: 70,&#xa;      &quot;forkHeight&quot;: 7,&#xa;      &quot;miniPadding&quot;: 2,&#xa;      &quot;fontSizeFactor&quot;: 5.02,&#xa;      &quot;fontSize&quot;: 24,&#xa;      &quot;labelHeight&quot;: 16,&#xa;      &quot;edgeLengthFactor&quot;: &quot;20&quot;,&#xa;      &quot;compositTitleSize&quot;: 35,&#xa;      &quot;radius&quot;: 5&#xa;    }