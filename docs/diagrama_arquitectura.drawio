                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef usuario fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A;\n    classDef coordinacion fill:#EDE9FE,stroke:#7C3AED,color:#4C1D95;\n    classDef funcion fill:#DCFCE7,stroke:#16A34A,color:#14532D;\n    classDef credencial fill:#FEF3C7,stroke:#D97706,color:#78350F;\n    classDef salida fill:#F1F5F9,stroke:#64748B,color:#0F172A;\n    classDef error fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D;\n\n    subgraph LEYENDA[\&quot;Leyenda\&quot;]\n        direction TB\n        L1[\&quot;Acción del usuario&lt;br/&gt;Entrada o instrucción\&quot;]:::usuario\n        L2[\&quot;Coordinación&lt;br/&gt;Control del proceso\&quot;]:::coordinacion\n        L3[\&quot;Función del código&lt;br/&gt;Lógica ejecutada\&quot;]:::funcion\n        L4[\&quot;Credencial&lt;br/&gt;Configuración protegida\&quot;]:::credencial\n        L5[\&quot;Salida&lt;br/&gt;Resultado en consola\&quot;]:::salida\n        L6[\&quot;Excepción&lt;br/&gt;Error o falla\&quot;]:::error\n\n        L1 ~~~ L2\n        L2 ~~~ L3\n        L3 ~~~ L4\n        L4 ~~~ L5\n        L5 ~~~ L6\n    end&quot;,&#xa;  &quot;config&quot;: {&#xa;    &quot;startOnLoad&quot;: false,&#xa;    &quot;themeCSS&quot;: &quot;&quot;,&#xa;    &quot;theme&quot;: &quot;default&quot;,&#xa;    &quot;arrowMarkerAbsolute&quot;: false,&#xa;    &quot;flowchart&quot;: {&#xa;      &quot;diagramPadding&quot;: 8,&#xa;      &quot;htmlLabels&quot;: true,&#xa;      &quot;nodeSpacing&quot;: 50,&#xa;      &quot;rankSpacing&quot;: 50,&#xa;      &quot;curve&quot;: &quot;linear&quot;,&#xa;      &quot;padding&quot;: 15,&#xa;      &quot;useMaxWidth&quot;: true&#xa;    },&#xa;    &quot;sequence&quot;: {&#xa;      &quot;activationWidth&quot;: 10,&#xa;      &quot;diagramMarginX&quot;: 50,&#xa;      &quot;diagramMarginY&quot;: 10,&#xa;      &quot;actorMargin&quot;: 50,&#xa;      &quot;width&quot;: 150,&#xa;      &quot;height&quot;: 65,&#xa;      &quot;boxMargin&quot;: 10,&#xa;      &quot;boxTextMargin&quot;: 5,&#xa;      &quot;noteMargin&quot;: 10,&#xa;      &quot;messageMargin&quot;: 35,&#xa;      &quot;messageAlign&quot;: &quot;center&quot;,&#xa;      &quot;mirrorActors&quot;: true,&#xa;      &quot;bottomMarginAdj&quot;: 1,&#xa;      &quot;useMaxWidth&quot;: true,&#xa;      &quot;rightAngles&quot;: false,&#xa;      &quot;showSequenceNumbers&quot;: false,&#xa;      &quot;actorFontSize&quot;: 14,&#xa;      &quot;actorFontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#xa;      &quot;actorFontWeight&quot;: 400,&#xa;      &quot;noteFontSize&quot;: 14,&#xa;      &quot;noteFontFamily&quot;: &quot;\&quot;trebuchet ms\&quot;, verdana, arial&quot;,&#xa;      &quot;noteFontWeight&quot;: 400,&#xa;      &quot;noteAlign&quot;: &quot;center&quot;,&#xa;      &quot;messageFontSize&quot;: 16,&#xa;      &quot;messageFontFamily&quot;: &quot;\&quot;trebuchet ms\&quot;, verdana, arial&quot;,&#xa;      &quot;messageFontWeight&quot;: 400,&#xa;      &quot;wrap&quot;: false,&#xa;      &quot;wrapPadding&quot;: 10,&#xa;      &quot;labelBoxWidth&quot;: 50,&#xa;      &quot;labelBoxHeight&quot;: 20&#xa;    },&#xa;    &quot;gantt&quot;: {&#xa;      &quot;titleTopMargin&quot;: 25,&#xa;      &quot;barHeight&quot;: 20,&#xa;      &quot;barGap&quot;: 4,&#xa;      &quot;topPadding&quot;: 50,&#xa;      &quot;leftPadding&quot;: 75,&#xa;      &quot;gridLineStartPadding&quot;: 35,&#xa;      &quot;fontSize&quot;: 11,&#xa;      &quot;fontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#xa;      &quot;numberSectionStyles&quot;: 4,&#xa;      &quot;axisFormat&quot;: &quot;%Y-%m-%d&quot;,&#xa;      &quot;useMaxWidth&quot;: true&#xa;    },&#xa;    &quot;journey&quot;: {&#xa;      &quot;diagramMarginX&quot;: 50,&#xa;      &quot;diagramMarginY&quot;: 10,&#xa;      &quot;actorMargin&quot;: 50,&#xa;      &quot;width&quot;: 150,&#xa;      &quot;height&quot;: 65,&#xa;      &quot;boxMargin&quot;: 10,&#xa;      &quot;boxTextMargin&quo